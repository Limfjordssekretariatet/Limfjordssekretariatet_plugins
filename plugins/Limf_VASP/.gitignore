# Lokal data-cache: GeoPackagen genopbygges fra brugerens Access-database
# (tools/rebuild_gpkg.ps1) ved første databasevalg / "Genindlæs". Distribueres
# derfor ikke – hver bruger genererer sin egen.
vasp_data.gpkg

# Access-database + eksport-mellemfiler (lokale)
*.mdb
*.accdb
*.ldb
_*.tsv

# Vandspejlsberegninger + projektdata (lokale, ligger hos VASP-databasen)
PRJDATA/
*.ber

# Eksempel-/testdata (kun til udvikling)
Eksempel/
tools/_movetest.py

# Database-backup før tilbageskrivning
backups/

# Gamle plugin-versioner (udvikling)
_versions/

# Claude / udvikling
CLAUDE.md
.claude/

# Python
__pycache__/
*.pyc
